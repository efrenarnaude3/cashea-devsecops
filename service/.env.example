# Copiar a .env solo para desarrollo local. El .env real nunca se commitea.
#
# En el clúster estas variables salen de un Secret creado desde Secret Manager,
# y en Cloud Run de --set-secrets. Nunca se hornean en la imagen ni se pasan
# como ARG del Dockerfile: un ARG queda en el historial de capas.

NODE_ENV=development
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
DEMO_API_TOKEN=generá-un-token-random-local
